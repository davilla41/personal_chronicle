---
const { titulo, descripcion, stack = [], url } = Astro.props;
---

<a href={url} target="_blank" rel="noopener" class="group block rounded-xl border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:border-accent/60">
  <h3 class="font-semibold group-hover:text-accent">{titulo}</h3>
  <p class="mt-2 text-sm text-muted">{descripcion}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {stack.map((s) => <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">{s}</li>)}
  </ul>
</a>
