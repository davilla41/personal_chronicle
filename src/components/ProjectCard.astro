---
const { title, description, stack = [], url } = Astro.props;
// With a url the card is a link; without one it is a plain block.
const Tag = url ? 'a' : 'div';
const linkProps = url ? { href: url, target: '_blank', rel: 'noopener' } : {};
---

<Tag {...linkProps} class:list={['group block rounded-xl border border-line bg-surface p-5 transition', url && 'hover:-translate-y-0.5 hover:border-accent/60']}>
  <h3 class:list={['font-semibold', url && 'group-hover:text-accent']}>{title}</h3>
  <p class="mt-2 text-sm text-muted">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {stack.map((s) => <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">{s}</li>)}
  </ul>
</Tag>
