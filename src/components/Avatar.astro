---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';

// Pass Tailwind size classes via `class` (e.g. "size-24 sm:size-36").
const { class: cls = 'size-24' } = Astro.props;
---

<Image
  src={profile}
  alt="David Villanueva"
  width={400}
  height={400}
  class:list={['shrink-0 rounded-full border-2 border-white object-cover', cls]}
/>
