---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { projects } from '../data/projects.js';

const posts = (await getCollection('journal', (p) => !p.data.draft))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 3);
---

<BaseLayout>
  <section class="pb-20">
    <p class="font-mono text-sm text-accent">Hi, I'm</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-6xl">David Villanueva</h1>
    <p class="mt-2 text-xl text-muted sm:text-2xl">Senior Data Engineer</p>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      I build reliable data pipelines and <span class="text-fg">automate</span> them end to end:
      modeling with <span class="text-fg">dbt</span> on <span class="text-fg">Snowflake</span>,
      processing with <span class="text-fg">Python</span> and PySpark, and visualization in Tableau and Power BI.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="#projects" class="rounded-lg bg-fg px-4 py-2 text-sm font-medium text-bg hover:bg-fg/90">View projects</a>
      <a href="/journal" class="rounded-lg border border-line px-4 py-2 text-sm hover:border-accent">Read the journal</a>
    </div>
  </section>

  <section id="projects" class="pb-20">
    <h2 class="mb-6 text-sm font-mono uppercase tracking-widest text-muted">Featured projects</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <section>
    <div class="mb-2 flex items-baseline justify-between">
      <h2 class="text-sm font-mono uppercase tracking-widest text-muted">Latest entries</h2>
      <a href="/journal" class="text-sm text-muted hover:text-accent">View all →</a>
    </div>
    {posts.map((p) => <PostRow post={p} />)}
  </section>
</BaseLayout>
